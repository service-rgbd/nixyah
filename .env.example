# Backend Database (Neon PostgreSQL)
# Set this to your Neon database connection string
DATABASE_URL=postgresql://user:password@hostname/database

# API Server Port
PORT=3333

# JWT Secret for token signing
JWT_SECRET=your_jwt_secret_key_here
VAPID_PUBLIC_KEY=BD43opm0aG0iY221SQfDdYZM5kWHY50QEFDePfIaPj1JW4M8XUXNfnj5UedvZw8jQeTm86UtRGDXgy-8yS8in04
VAPID_PRIVATE_KEY=uWmqrcYPvaSycXOHiIemogKqefMgeLWa5OqSig7un00
VAPID_SUBJECT=mailto:you@example.com

# Expo Mobile - API Base URL
# Use this to point the mobile app to your local dev server
EXPO_PUBLIC_API_URL=http://localhost:3333/api

# Public API URL used by backend emails / browser fallbacks
API_PUBLIC_URL=http://localhost:3333/api

# Mobile deep link opened from email confirmation
EXPO_PUBLIC_APP_URL=mobile://

# Optional public frontend origin for CORS / redirects
FRONTEND_URL=http://localhost:19006

# Cloudflare R2 / S3-compatible uploads
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=your_bucket_name
R2_PUBLIC_BASE_URL=https://media.example.com

# Resend email configuration
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Nixyah <no-reply@example.com>

# Optional extra CORS origins (comma separated)
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# For local IP testing on real devices, use:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3333/api
# API_PUBLIC_URL=https://api.nixyah.com/api
