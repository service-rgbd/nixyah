# Backend Database (Neon PostgreSQL)
# Set this to your Neon database connection string
DATABASE_URL=postgresql://user:password@hostname/database

# API Server Port
PORT=3333

# JWT Secret for token signing
JWT_SECRET=your_jwt_secret_key_here
# Optional explicit JWT metadata
JWT_ISSUER=ivory-diaspora-api
JWT_AUDIENCE=ivory-diaspora-clients
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Expo Mobile - API Base URL
# Default to the hosted Render backend
EXPO_PUBLIC_API_URL=https://api.nixyah.com/api

# Public API URL used by backend emails / browser fallbacks
API_PUBLIC_URL=https://api.nixyah.com/api

# Mobile deep link opened from email confirmation
EXPO_PUBLIC_APP_URL=mobile://

# Expo push project id used by expo-notifications token registration
# Required when the Expo config does not already expose expo.extra.eas.projectId
EXPO_PUBLIC_EXPO_PROJECT_ID=your-expo-eas-project-id

# Directions provider for in-app courier/client tracking map
# Use "mapbox" to enable Mapbox Directions API in the mobile app.
EXPO_PUBLIC_DIRECTIONS_PROVIDER=mapbox


EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token


EXPO_PUBLIC_MAPBOX_DIRECTIONS_PROFILE=driving-traffic

# Optional fallback if you want to keep a non-Mapbox routing provider available.
# EXPO_PUBLIC_DIRECTIONS_API_URL=https://router.project-osrm.org
# EXPO_PUBLIC_DIRECTIONS_PROFILE=driving

# Optional public frontend origin for CORS / redirects
FRONTEND_URL=http://localhost:19006

# Cloudflare R2 / S3-compatible uploads
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=your_bucket_name
R2_PUBLIC_BASE_URL=https://media.example.com

# Resend email configuration
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Nixyah <no-reply@example.com>

# Optional extra CORS origins (comma separated)
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# For local IP testing on real devices, use:
# EXPO_PUBLIC_USE_LOCAL_API=1
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3333/api
# API_PUBLIC_URL=http://192.168.x.x:3333/api
